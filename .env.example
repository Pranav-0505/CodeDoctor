# Code Doctor — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Required ---
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production

# --- Optional: Google Gemini AI (for AI-enhanced explanations) ---
# Leave blank to use offline/mock mode
GEMINI_API_KEY=

# --- Database (SQLite used by default, no config needed) ---
# For PostgreSQL: postgresql://user:password@localhost:5432/codedoctor
DATABASE_URL=sqlite:///./code_doctor.db

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
